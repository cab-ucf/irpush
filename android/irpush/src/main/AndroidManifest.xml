<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into every app that uses irpush. The app names its group
     (manifestPlaceholders["irpushGroup"], e.g. its developer's reverse
     domain): apps of one group, signed by one key, share one connection. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Only apps signed by the same key hold it: they alone may attach to
         the owner or wake an app. -->
    <permission
        android:name="${irpushGroup}.permission.IRPUSH"
        android:protectionLevel="signature" />
    <uses-permission android:name="${irpushGroup}.permission.IRPUSH" />

    <!-- Find the other irpush apps on the phone (package visibility). -->
    <queries>
        <intent><action android:name="org.irpush.ATTACH" /></intent>
    </queries>

    <application>
        <service
            android:name="org.irpush.Broker"
            android:exported="true"
            android:permission="${irpushGroup}.permission.IRPUSH"
            android:foregroundServiceType="remoteMessaging">
            <intent-filter><action android:name="org.irpush.ATTACH" /></intent-filter>
        </service>
        <receiver android:name="org.irpush.Alarm" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Carries no data: it only makes the app attach and fetch. -->
        <receiver
            android:name="org.irpush.Wake"
            android:exported="true"
            android:permission="${irpushGroup}.permission.IRPUSH">
            <intent-filter><action android:name="org.irpush.WAKE" /></intent-filter>
        </receiver>
    </application>
</manifest>
